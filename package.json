{
  "name": "flock-energy-api",
  "version": "1.0.0",
  "description": "Clean, modern REST API proxy and React.js explorer over legacy Urja Meter Ops portal",
  "main": "app/main.js",
  "scripts": {
    "start": "node app/main.js",
    "dev": "node --watch app/main.js",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "flock-energy",
    "smart-meter",
    "rest-api",
    "react",
    "scraper",
    "urja-portal"
  ],
  "author": "Operator",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^5.0.5",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1",
    "tough-cookie": "^5.1.1"
  }
}
